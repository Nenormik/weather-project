pipeline {
    agent any
    stages {
        stage('Preparing') {
            steps {
                script {
                    sh('''
                    echo "---------------Clearing All Containers:------------------------"
                    docker stop $(docker ps -aq) || true  # Останавливаем все контейнеры
                    docker rm $(docker ps -aq) || true  # Удаляем все контейнеры
                    sleep 5  # Ждем освобождения портов
                    ''')
                }
            }    
        }

        stage('Building') {
            steps {
                script { 
                    sh('''
                    ls -la
                    pwd
                    systemctl status docker
                    cd myapp
                    pwd
                    docker build -t weather-app .

                    echo "---------------Running App container:------------------------"
                    docker run -d --restart unless-stopped -p 8099:8099 --name weather-app weather-app

                    echo "---------------Running Prometheus container:------------------------"
                    docker run -d --restart unless-stopped --name prometheus -p 9090:9090 -v $(pwd)/prometheus.yml:/etc/prometheus/prometheus.yml prom/prometheus

                    echo "-----------------Running Grafana container:--------------------------"
                    docker run -d --restart unless-stopped --name grafana -p 3000:3000 grafana/grafana
                    docker ps

                    echo "-----------------Running cAdvisor container:--------------------------"
                    docker run -d \
                        --name=cadvisor-gcr \
                        --privileged \
                        --publish=8091:8080 \
                        --volume=/:/rootfs:ro \
                        --volume=/var/run:/var/run:rw \
                        --volume=/sys:/sys:ro \
                        --volume=/var/lib/docker/:/var/lib/docker:ro \
                        --volume=/sys/fs/cgroup:/sys/fs/cgroup:rw \
                        -e CADVISOR_CGROUP_V2=true \
                        gcr.io/cadvisor/cadvisor:latest
                    
                    echo "-----------------Running Node Exporter container:--------------------------"
                    docker run -d --restart unless-stopped --name node_exporter -p 9100:9100 prom/node-exporter
                    ''')
                }
            }
        }
    }
}
